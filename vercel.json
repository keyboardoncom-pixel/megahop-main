{
  "rewrites": [
    {
      "source": "/megahop-adventure/",
      "destination": "/megahop-adventure/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/megahop-adventure/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/megahop-adventure/game.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/megahop-adventure/style.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/megahop-adventure/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/megahop-adventure/index.html",
      "destination": "/megahop-adventure/",
      "permanent": true
    },
    {
      "source": "/megahop-adventure",
      "destination": "/megahop-adventure/",
      "permanent": true
    }
  ]
}
